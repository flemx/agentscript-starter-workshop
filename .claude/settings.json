{
  "$comment": "Project settings for the Agentforce Hackathon workspace. Merges with the user's global ~/.claude/settings.json. The secret-guard PreToolUse hook blocks any git commit whose staged diff contains an API key/token — this package is handed to customers, so it must never contain secrets.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/secret_guard.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git commit:*)",
      "Bash(sf project deploy:*)",
      "Bash(sf project retrieve:*)",
      "Bash(sf package version create:*)",
      "Bash(sf package install:*)",
      "Bash(sf package installed list:*)",
      "Bash(sf org list:*)",
      "Bash(sf org display:*)",
      "Bash(sf org open:*)",
      "Bash(sf org create scratch:*)",
      "Bash(sf apex run:*)",
      "Bash(sf data query:*)"
    ]
  }
}
