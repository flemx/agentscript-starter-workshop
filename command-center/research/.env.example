# Internal ENG AI Model Gateway (LiteLLM proxy) — used by command-center/scripts/gateway.mjs
# for async, non-blocking LLM chores (session title/summary, work-item classification, PROGRESS bullets).
#
# Copy this file to `.env` (which is GITIGNORED) and paste the real key. NEVER commit the real key —
# the secret-guard PreToolUse hook will block any commit whose staged diff contains one.
#
# If this key is absent, the harness still works: the portal regenerates deterministically every turn;
# only the soft LLM-filled fields (session summaries, auto-classification) are skipped.
ENG_AI_MODEL_GW_KEY=

# Optional overrides (defaults live in gateway.mjs):
# ENG_AI_MODEL_GW_URL=https://your-gateway-host
# ENG_AI_MODEL=claude-haiku-4-5-20251001
