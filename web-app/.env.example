# Copy to .env and fill in. NEVER commit real values — .env is gitignored.

# Connected App (client-credentials flow) consumer key/secret for the Agentforce API.
CONSUMER_KEY=
CONSUMER_SECRET=

# Agentforce API target.
SF_INSTANCE_URL=https://your-org.my.salesforce.com
SF_AGENT_ID=0Xx...                     # BotDefinition Id of the hosted demo agent

# Heroku Managed Inference — vision (image/PDF → text). OpenAI-compatible.
INFERENCE_URL=
INFERENCE_KEY=
INFERENCE_MODEL_ID=

# Heroku Managed Inference — speech-to-text (audio → text).
STT_URL=
STT_KEY=
STT_MODEL_ID=
