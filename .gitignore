# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# ─────────────────────────────────────────────────────────────
#  AI COMMAND CENTER (command-center/) — secrets & raw logs
#  This package is handed to customers; keep keys and raw chat
#  out of git. We commit ONLY the session INDEX (metadata) via
#  command-center/data/sessions/index.json and portal-data.js.
# ─────────────────────────────────────────────────────────────
# Secrets — the LLM gateway key lives in command-center/research/.env (copy from .env.example)
.env
.env.*
**/.env
**/.env.*
*.key
*.pem
# …but DO keep the keyless template (negations come AFTER the ignores above so they win)
!.env.example
!**/.env.example

# Raw agent/Claude transcripts + per-session timelines — may contain secrets/customer context
**/agentic-history/raw/
!**/agentic-history/raw/.gitkeep
**/*.session.jsonl
# per-session sanitized timelines (full conversation text) — local only
command-center/data/sessions/*.json
!command-center/data/sessions/index.json
command-center/data/sessions/.capture.log
# full-text browser bundle — local only; portal-data.js (the index) IS committed
command-center/sessions-data.js
# historical portal snapshots — rebuildable from git via build_versions.mjs (manifest IS committed)
command-center/versions/
.claude/projects/
.claude/sessions/
.claude/history.jsonl
