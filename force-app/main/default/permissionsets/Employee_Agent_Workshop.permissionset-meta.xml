<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Employee Agent Workshop</label>
    <description>Workshop access: setup controller + deploy accelerator, RunFlow, the workshop app + Home tab. Standard Agentforce/Prompt Template perms are assigned separately by the launchpad.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>WorkshopSetupController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NextGenAgentDeployer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <pageAccesses>
        <apexPage>NextGenAgentDeployerSession</apexPage>
        <enabled>true</enabled>
    </pageAccesses>
    <applicationVisibilities>
        <application>Employee_Agent_Workshop</application>
        <visible>true</visible>
    </applicationVisibilities>
    <tabSettings>
        <tab>Employee_Agent_Workshop_Home</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Employee_Agent_Workshop_Notes</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <userPermissions>
        <enabled>true</enabled>
        <name>RunFlow</name>
    </userPermissions>
</PermissionSet>
