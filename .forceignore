# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# AiAuthoringBundle (Agent Script agents) cannot be packaged — exclude from package builds.
# The agent is deployed at runtime by the browser accelerator / built in Agent Studio.
**/aiAuthoringBundles/**


# Published-agent runtime metadata (Bot, BotVersion, GenAiPlannerBundle/GenAiPlugin) — these are
# created at runtime when an agent is published; they must NOT be packaged (agents are deployed by
# the launchpad at runtime, like AiAuthoringBundle). Exclude from package builds.
**/bots/**
**/genAiPlannerBundles/**
**/genAiPlanners/**
**/genAiPlugins/**
